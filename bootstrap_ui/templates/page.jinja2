<!DOCTYPE html>
<html lang="{{ lang }}"{% if theme %} data-bs-theme="{{ theme }}"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if icons %}<link rel="stylesheet" href="{{ cdn }}/bootstrap-icons@{{ icons_version }}/font/bootstrap-icons.min.css">
  {% endif %}<link rel="stylesheet" href="{{ cdn }}/bootstrap@{{ version }}/dist/css/bootstrap.min.css">
  {% for href in css %}  <link rel="stylesheet" href="{{ href }}">
  {% endfor %}{% if page_css %}  <style>
{{ page_css }}
  </style>
  {% endif %}{% if head %}{{ head }}
  {% endif %}</head>
<body{% if body_class %} class="{{ body_class }}"{% endif %}>
{{ navbar }}
{% if container %}<div class="{{ container_class }} py-4">
  {% if toolbar %}<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">{{ toolbar }}</div>
  {% endif %}{{ body }}
</div>
{% else %}{{ body }}
{% endif %}{{ footer }}
<script src="{{ cdn }}/bootstrap@{{ version }}/dist/js/bootstrap.bundle.min.js"></script>
{% for src in js %}<script src="{{ src }}"></script>
{% endfor %}<script>
  // 初始化全部提示气泡
  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
    new bootstrap.Tooltip(el);
  });
  // 页面加载后自动弹出 Toast
  document.querySelectorAll('.toast').forEach(function (el) {
    new bootstrap.Toast(el).show();
  });
{{ page_js }}
</script>
</body>
</html>
